# Self-host only — `docker compose --profile dashboard up` reads this via its auto-loaded `.env`.
# Copy to `.env`, fill in real values, then: docker compose --profile dashboard up --build

AUTH_SECRET=
# Create at https://console.cloud.google.com/apis/credentials
#   Application type: Web application
#   Authorised redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Unset means ANY Google account may sign in. Set it for anything beyond a local try-out.
# ALLOWED_EMAIL_DOMAINS=yourcompany.com
