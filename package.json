{
  "name": "caplytics-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "bun run --filter '*' build",
    "typecheck": "bun run --filter '*' typecheck && tsc --noEmit",
    "test": "bun test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "verify": "bun run lint && bun run typecheck && bun run build && bun run test",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down -v",
    "test:integration": "CAPLYTICS_TEST_DATABASE_URL=postgres://caplytics:caplytics@localhost:5433/caplytics bun test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.14",
    "@types/bun": "^1.3.11",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3"
  }
}
