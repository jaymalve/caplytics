{
  "name": "@caplytics/core",
  "version": "0.1.0",
  "description": "Shared event schema, cost model, and query layer for Caplytics.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./postgres": {
      "types": "./dist/postgres/index.d.ts",
      "default": "./dist/postgres/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/pg": "^8.21.0",
    "pg": "^8.23.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jaymalave/caplytics.git",
    "directory": "packages/core"
  }
}
