{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "jsx": "preserve",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node", "react", "bun"],
    "moduleResolution": "bundler",
    "allowJs": true,
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    // No source mappings for @caplytics/core here, deliberately. Next's bundler reads these paths
    // too, and core's sources carry Node-ESM ".js" specifiers that webpack cannot resolve against
    // ".ts" files — so a mapping that satisfies tsc breaks the build. Both resolve it through the
    // package exports map instead, which is what a published consumer gets.
    "paths": {
      "@/*": ["./*"]
    },
    "declaration": false,
    "declarationMap": false,
    "baseUrl": ".",
    "exactOptionalPropertyTypes": false,
    // Vendored beUI source (components/motion, components/charts) indexes arrays unchecked, and
    // tsc checks whatever is imported regardless of `exclude`. Relaxed package-wide for the same
    // reason as the line above; see architecture/dashboard-overview-layout.md.
    "noUncheckedIndexedAccess": false
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
